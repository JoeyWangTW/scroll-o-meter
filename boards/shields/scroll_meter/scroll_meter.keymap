#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* DIAGNOSTIC: each of the 5 kscan inputs types a distinct letter.
           User shorts each pin (D2..D6) to GND in turn:
             D2 → 'a'  (also: encoder-side pin? shouldn't be, A is on D7)
             D3 → 'b'
             D4 → 'c'
             D5 → 'd'
             D6 → 'e'
           Encoder rotation sends C_VOL_UP / C_VOL_DOWN — these are
           consumer (media) reports, which take effect on iOS even
           without a focused text field, so we can verify both
           HID-keyboard and HID-consumer paths independently. */
        default_layer {
            bindings = <&kp A &kp B &kp C &kp D &kp E>;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DOWN>;
        };
    };
};
