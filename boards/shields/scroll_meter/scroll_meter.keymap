#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        /* Match agent-keyboard's iphone-scroll-encoder branch exactly:
           speed 90 with tap-ms 18 emits ~1 wheel unit per detent on
           iOS so scroll-acceleration stays sane. */
        enc_scroll: enc_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(-90)>, <&msc MOVE_Y(90)>;
            tap-ms = <18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Encoder: HID mouse-scroll (iOS via AssistiveTouch + Mac).
               Kscan still on D4/D5/D6 → c/d/e for now. */
            bindings = <&kp C &kp D &kp E>;
            sensor-bindings = <&enc_scroll>;
        };
    };
};
