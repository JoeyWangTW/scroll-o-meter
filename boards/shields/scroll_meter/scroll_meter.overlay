#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &single_key_transform;
    };

    /* EC11 rotary encoder. Pins all chosen on the LEFT side of the
       Pro Micro footprint because nice_nano and SuperMini-NRF52840
       boards diverge on right-side pin assignments — left side is
       identical (D0-D9 → P0.06, P0.08, P0.17, P0.20, P0.22, P0.24,
       P1.00, P0.11, P1.04, P1.06).

       A → pro_micro pin 2 (D2 / P0.17)   - rotation phase A
       B → pro_micro pin 3 (D3 / P0.20)   - rotation phase B
       C → GND                            - encoder common
       Switch → pin 4 (D4 / P0.22) to GND
    */
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <40>;
    };

    /* Single press button (encoder push) — direct GPIO, no matrix. */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    single_key_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <1>;
        rows = <1>;
        map = <RC(0,0)>;
    };

    behaviors {
        count_print: count_print {
            compatible = "zmk,behavior-count-print";
            #binding-cells = <0>;
        };
        count_reset: count_reset {
            compatible = "zmk,behavior-count-reset";
            #binding-cells = <0>;
        };
    };
};

/* Silence the BLE advertising / status indicator LED. nice_nano defines
   blue_led on P0.15 and Zephyr's BT host blinks it during advertising;
   on the SuperMini-NRF52840 the LED is wired to a different pin so this
   may or may not have an effect, but disabling the node ensures ZMK
   stops driving P0.15 either way. */
&blue_led {
    status = "disabled";
};
