#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &row_transform;
    };

    /* DIAGNOSTIC BUILD: 5 separate kscan inputs on left-side pins so
       we can identify which (if any) actually fires on the user's
       hardware. Each maps to a unique letter via the keymap. Encoder
       moved to D7/D8 (well clear of i2c0's default pinctrl on D2/D3). */
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <40>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    row_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <1>;
        map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)>;
    };

    behaviors {
        count_print: count_print {
            compatible = "zmk,behavior-count-print";
            #binding-cells = <0>;
        };
        count_reset: count_reset {
            compatible = "zmk,behavior-count-reset";
            #binding-cells = <0>;
        };
    };
};

/* Explicitly disable peripherals whose default pinctrl claims left-side
   pins. nice_nano.dts assigns pinctrl-0 to i2c0 referencing P0.17/P0.20
   (D2/D3) and to spi1 / uart0 — even if those peripherals lack
   status="okay" in the upstream board, leaving them present invites
   confusion. Force them off. */
&i2c0  { status = "disabled"; };
&spi1  { status = "disabled"; };
&uart0 { status = "disabled"; };

&blue_led {
    status = "disabled";
};
