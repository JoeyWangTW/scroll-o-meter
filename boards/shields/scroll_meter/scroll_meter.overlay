#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &row_transform;
    };

    /* DIAGNOSTIC BUILD: encoder moved to D2/D3, the exact pins we just
       confirmed work for HID input via the kscan diagnostic. If
       rotation works here, D7/D8 specifically were the problem. If it
       still doesn't work, the EC11 driver path or encoder hardware is. */
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <40>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    row_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows = <1>;
        map = <RC(0,0) RC(0,1) RC(0,2)>;
    };

    behaviors {
        count_print: count_print {
            compatible = "zmk,behavior-count-print";
            #binding-cells = <0>;
        };
        count_reset: count_reset {
            compatible = "zmk,behavior-count-reset";
            #binding-cells = <0>;
        };
    };
};

&i2c0  { status = "disabled"; };

&blue_led {
    status = "disabled";
};
